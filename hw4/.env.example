# Copy to hw4/.env and fill in. Real .env files are git-ignored.

# Required: Portkey gateway key used to reach the gpt-5.6-luna model
PORTKEY_API_KEY=your-portkey-key-here

# Recommended: secret used to sign login session tokens (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional overrides
# OPENAI_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
